{
  "name": "claude-code (rw repo + tmpfs, ro rootfs, rust)",
  "dockerComposeFile": ["docker-compose.yml"],
  "service": "dev",
  "workspaceFolder": "/workspaces/repo",
  "remoteUser": "vscode",
  "overrideCommand": false,
  "shutdownAction": "stopCompose",
  "postCreateCommand": "bash .devcontainer/ensure-claude.sh",
  "remoteEnv": {
    "NPM_CONFIG_PREFIX": "/home/vscode/.npm-global",
    "PATH": "/home/vscode/.npm-global/bin:${containerEnv:PATH}"
  }
}
